{
   "background": {
      "service_worker": "background.js"
   },
   "content_security_policy": {
     "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "Let you edit riak database records from your browser window",
   "icons": {
     "16": "icons/icon16.png",
     "19": "icons/icon19.png",
     "24": "icons/icon24.png",
     "32": "icons/icon32.png",
     "48": "icons/icon48.png",
     "64": "icons/icon64.png",
     "128": "icons/icon128.png",
     "256": "icons/icon256.png"
   },
   "manifest_version": 3,
   "name": "Riak JSON editor OTT",
   "permissions": [
     "storage",
     "tabs"
   ],
   "host_permissions": [
     "http://*/*",
     "https://*/*"
   ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.12",
   "web_accessible_resources": [ "res/*", "assets/*", "icons/*" ],
   "options_ui": {
     "page": "options.html",
     "open_in_tab": false
   },
   "action": {
     "default_icon": {
       "16": "icons/icon16.png",
       "19": "icons/icon19.png",
       "24": "icons/icon24.png",
       "32": "icons/icon32.png",
       "48": "icons/icon48.png",
       "64": "icons/icon64.png",
       "128": "icons/icon128.png",
       "256": "icons/icon256.png"
     },
     "default_title": "Riak JSON Editor"
   },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["override.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "editor.css",
        "editor.html",
        "editor.js",
        "jsoneditor.min.css",
        "jsoneditor.min.js",
        "mustache-3.2.1.min.js",
        "override-params.js",
        "res/*",
        "icons/*",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
