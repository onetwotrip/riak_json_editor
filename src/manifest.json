{
   "background": {
      "service_worker": "/pages/background.js"
   },
   "content_security_policy": {
     "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "Lets you edit Riak database records from your browser window",
   "icons": {
     "16": "icons/icon16.png",
     "19": "icons/icon19.png",
     "24": "icons/icon24.png",
     "32": "icons/icon32.png",
     "48": "icons/icon48.png",
     "64": "icons/icon64.png",
     "128": "icons/icon128.png",
     "256": "icons/icon256.png"
   },
   "manifest_version": 3,
   "name": "Riak JSON editor OTT",
   "permissions": [
     "storage",
     "tabs"
   ],
   "host_permissions": [
     "http://*/*",
     "https://*/*"
   ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.0.0",
   "web_accessible_resources": [ "res/*", "assets/*", "icons/*" ],
   "options_ui": {
     "page": "/pages/options/options.html",
     "open_in_tab": false
   },
   "action": {
     "default_icon": {
       "16": "icons/icon16.png",
       "19": "icons/icon19.png",
       "24": "icons/icon24.png",
       "32": "icons/icon32.png",
       "48": "icons/icon48.png",
       "64": "icons/icon64.png",
       "128": "icons/icon128.png",
       "256": "icons/icon256.png"
     },
     "default_title": "Riak JSON Editor"
   },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["/pages/override.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pages/*",
        "vendor/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
